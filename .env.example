# نمونه‌ی متغیرهای محیطی برای اجرا روی هاست (این فایل را به .env کپی و مقداردهی کنید)

# پورت (هاست معمولاً خودش مقداردهی می‌کند)
PORT=3000

# حالت تولید (مرورگر خودکار باز نمی‌شود)
NODE_ENV=production

# رمز عبور ورود به داشبورد مدیر (حتماً یک مقدار قوی بگذارید)
ADMIN_PASSWORD=

# کلید امضای نشست‌ها (یک رشته‌ی تصادفی بلند). اگر خالی باشد از روی رمز ساخته می‌شود.
SESSION_SECRET=
